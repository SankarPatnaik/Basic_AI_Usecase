# Create a key at https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_key

# A small, fast production model suitable for this beginner project.
GROQ_MODEL=llama-3.1-8b-instant

# Optional local Qwen model served by Ollama.
LOCAL_QWEN_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120

# Local embedding model downloaded on first run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PATH=chroma_db
COLLECTION_NAME=student_rag_documents
TOP_K=4
